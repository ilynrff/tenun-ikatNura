// ============================================================
// PRISMA SCHEMA — TENUN IKAT NURA
// Phase 3B: Order Database Foundation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products    Product[]

  @@map("categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id           String      @id @default(cuid())

  // Identifiers — must be unique
  sku          String      @unique
  slug         String      @unique

  // Basic info
  name         String
  tagline      String?
  description  String?
  story        String?

  // Material stored as JSON (matches existing structure: {type, composition, texture, comfort})
  material     Json?

  // Pricing
  price        Int         @default(0)   // Stored as integer IDR (e.g., 1450000)

  // Weight in grams (e.g., 1000 = 1kg)
  weight       Int         @default(1000)

  // Stock
  stock        Int         @default(0)

  // Images — ordered array of URL strings
  images       String[]    @default([])

  // Sizes / Variants — ordered array of strings (e.g., ["S","M","L","XL","Custom Size"])
  sizes        String[]    @default([])

  // Care instructions — array of strings
  care         String[]    @default([])

  // Colors — array of strings
  colors       String[]    @default([])

  // Flags
  isActive     Boolean     @default(true)
  isVisible    Boolean     @default(true)
  featured     Boolean     @default(false)
  signature    Boolean     @default(false)

  // Homepage arch gallery position (0 = not placed, 1-5 = position)
  archPosition Int         @default(0)

  // Category relation
  categorySlug String
  category     Category    @relation(fields: [categorySlug], references: [slug])

  // Order items relation
  orderItems   OrderItem[]

  // Timestamps
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categorySlug])
  @@index([isActive, isVisible])
  @@index([featured])
  @@map("products")
}

// ============================================================
// USER (CUSTOMER)
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]

  @@map("users")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique

  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerName       String
  customerWhatsapp   String
  customerEmail      String?

  shippingAddress    String
  shippingCity       String?
  shippingPostalCode String?

  note               String?

  subtotal           Int
  shippingCost       Int           @default(0)
  total              Int

  orderStatus        OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)

  items              OrderItem[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sku         String
  productName String

  size        String?
  variant     String?

  unitPrice   Int
  quantity    Int
  subtotal    Int

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
