# Admin Environment Configuration
ADMIN_EMAIL=admin@tenunikatnura.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SECRET=your_random_64_character_secret_key_here

# Supabase / PostgreSQL Database Connection (Prisma)
# Pooled connection string (used in production / serverless / Vercel):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (used by Prisma migrations and seed):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
